DATABASE_URL=postgresql+psycopg://gis:gis@localhost:5432/gis
GIS_TELEMETRY_SQS_QUEUE_URL=
AWS_PROFILE=
TELEMETRY_MAX_PAYLOAD_BYTES=65536
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=gis
DBT_PASSWORD=gis
DBT_DATABASE=gis
GIS_DB_NAME=gis
GIS_DB_USER=gis
GIS_DB_PASSWORD=gis

# Optional provider credentials referenced by gis-serp/gis-experience connections.
# DATAFORSEO_CREDENTIAL_JSON is JSON with login and password keys.
DATAFORSEO_CREDENTIAL_JSON=
# Local legacy env:GIS_DATAFORSEO_CREDENTIAL also resolves owner-only
# ~/.config/gis/secrets/dataforseo.env (DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD).
# Set 1 for no-paid-call acceptance; policies/history stay unchanged.
GIS_PAID_EXECUTION_DISABLED=0
PAGESPEED_API_KEY=
METABASE_PORT=3030
METABASE_URL=http://localhost:3030
# Set these only in your local .env before provisioning Metabase.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
METABASE_ADMIN_FIRST_NAME=GIS
METABASE_ADMIN_LAST_NAME=Operator
METABASE_GIS_DB_HOST=db
METABASE_GIS_DB_PORT=5432

# Local-only GIS Application API and Workbench control-plane configuration.
# Generate a private local value; mutations fail closed when this is unset.
GIS_API_OPERATOR_KEY=
GIS_API_CORS_ORIGINS=http://localhost:3000
GIS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GIS_TENANT_ID=
NEXT_PUBLIC_GIS_WORKBENCH_SITE_ID=
NEXT_PUBLIC_METABASE_URL=http://localhost:3030
# Optional BuiltWith key: prefer the owner-only local secret file documented in docs/gis/builtwith.md.
# Connections store env:GIS_BUILTWITH_CREDENTIAL, never the key itself.
